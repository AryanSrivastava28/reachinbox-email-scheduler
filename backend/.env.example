# Server
PORT=5000

# PostgreSQL (Prisma)
DATABASE_URL=postgresql://reachinbox:reachinbox@localhost:5432/reachinbox?schema=public

# Redis (BullMQ + sessions)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Session
SESSION_SECRET=change-me-to-a-long-random-string

# Ethereal SMTP (Nodemailer)
ETHEREAL_HOST=smtp.ethereal.email
ETHEREAL_PORT=587
ETHEREAL_USER=
ETHEREAL_PASSWORD=

# Worker
WORKER_CONCURRENCY=5

# Rate-limit defaults (used in Phase 2; kept for config completeness)
MIN_EMAIL_DELAY_MS=2000
MAX_EMAILS_PER_HOUR=200

# Frontend (CORS + OAuth redirect)
FRONTEND_URL=http://localhost:5173
